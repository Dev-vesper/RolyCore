!import map {new_map, map_set, map_get, map_has, map_del, map_size, map_keys, map_values, map_items, map_merge, show}

ages = new_map()
ages = map_set(ages, "ana", 31)
ages = map_set(ages, "bo", 27)
ages = map_set(ages, "cy", 31)

print(format("size: {}", map_size(ages)))
print(format("ana is {}", map_get(ages, "ana")))
print(format("bo present: {}", map_has(ages, "bo")))
print(format("dee present: {}", map_has(ages, "dee")))

ages = map_del(ages, "bo")
print(format("after del: {} {}", map_size(ages), map_has(ages, "bo")))

ages = map_set(ages, "ana", 32)
print(format("ana now {}", map_get(ages, "ana")))

profile = new_map()
profile = map_set(profile, "lang", "roly")
profile = map_set(profile, "tiny", TRUE)
profile = map_set(profile, "version", 1.5)
profile = map_set(profile, "words", ["map", "hash", "probe"])
profile = map_set(profile, 7, [49])

print(map_get(profile, "lang"))
print(map_get(profile, "tiny"))
print(map_get(profile, "version"))
print(map_get(profile, "words"))
print(map_get(profile, 7))
print(map_has(profile, "7"))

scores = new_map()
scores = map_set(scores, "ana", 9)
scores = map_set(scores, "dee", 6)
combined = map_merge(ages, scores)
print(format("merged size: {}", map_size(combined)))
print(format("ana wins right: {}", map_get(combined, "ana")))
print(format("dee carried: {}", map_get(combined, "dee")))

print(format("items: {}", map_items(combined)))
print(format("keys: {}", map_keys(combined)))
print(format("values: {}", map_values(combined)))
print(show(combined))
print(show(profile))
