!import map {new_map, put_str, put_int, put_bool, put_float, put_list, put_i, map_get, map_get_i, map_has, map_has_i, map_del, map_size, map_keys, map_values, map_items, map_merge, show}

ages = new_map()
ages = put_int(ages, "ana", 31)
ages = put_int(ages, "bo", 27)
ages = put_int(ages, "cy", 31)

print(format("size: {}", map_size(ages)))
print(format("ana is {}", map_get(ages, "ana")))
print(format("bo present: {}", map_has(ages, "bo")))
print(format("dee present: {}", map_has(ages, "dee")))

ages = map_del(ages, "bo")
print(format("after del: {} {}", map_size(ages), map_has(ages, "bo")))

ages = put_int(ages, "ana", 32)
print(format("ana now {}", map_get(ages, "ana")))

profile = new_map()
profile = put_str(profile, "lang", "roly")
profile = put_bool(profile, "tiny", TRUE)
profile = put_float(profile, "version", 1.5)
profile = put_list(profile, "words", ["map", "box", "hash"])
profile = put_i(profile, 7, [49])

print(map_get(profile, "lang"))
print(map_get(profile, "tiny"))
print(map_get(profile, "version"))
print(map_get(profile, "words"))
print(map_get_i(profile, 7))
print(map_has_i(profile, 8))

scores = new_map()
scores = put_int(scores, "ana", 9)
scores = put_int(scores, "dee", 6)
combined = map_merge(ages, scores)
print(format("merged size: {}", map_size(combined)))
print(format("ana wins right: {}", map_get(combined, "ana")))
print(format("dee carried: {}", map_get(combined, "dee")))

items = map_items(combined)
print(format("items: {}", items))
print(format("keys: {}", map_keys(combined)))
print(format("values: {}", map_values(combined)))
print(show(combined))
print(show(profile))
