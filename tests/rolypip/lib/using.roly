fn rep(s: str, n: int) {
    r = ""
    i = 0
    while (i < n) {
        r = r + s
        i += 1
    }
    return r
}

fn fact(n: int) {
    r = 1
    i = 2
    while (i <= n) {
        r *= i
        i += 1
    }
    return r
}

fn is_pal(n: int) {
    if (n < 0) {
        return FALSE
    }
    return n == reverse_digits(n)
}

a = 27
b = 36

print(gcd(a, b))
print(lcm(a, b))
print(mod(a, b))
print(max(a, b) + abs(-5))
print(isqrt(a * b))

n = 123456789
print(digit_sum(n))
print(reverse_digits(n))
print(is_pal(12321))

print(group(fact(12)))
print(hex(4096))
print(binary(255))
print(pad(7, 4))
print(roman(1994))

banner = "+" + rep("-", 20) + "+"
print(banner)
print("|" + "  roly standard library  " + "|")
print(banner)
