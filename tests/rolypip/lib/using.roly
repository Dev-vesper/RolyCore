!import math {gcd, lcm, mod, max, abs, isqrt}
!import strings {reverse_str}
!import fmt {group, hex, binary, pad, roman}

fn rep(s, n) {
    r = ""
    i = 0
    while (i < n) {
        r = r + s
        i += 1
    }
    return r
}

fn fact(n) {
    r = 1
    i = 2
    while (i <= n) {
        r *= i
        i += 1
    }
    return r
}

fn is_pal(n) {
    if (n < 0) {
        return FALSE
    }
    s = str(n)
    return s == reverse_str(s)
}

a = 27
b = 36

print(gcd(a, b))
print(lcm(a, b))
print(mod(a, b))
print(max(a, b) + abs(-5))
print(isqrt(a * b))

n = 123456789
print(reverse_str(str(n)))
print(is_pal(12321))

print(group(fact(12)))
print(hex(4096))
print(binary(255))
print(pad(7, 4))
print(roman(1994))

banner = "+" + rep("-", 20) + "+"
print(banner)
print("|" + "  roly standard library  " + "|")
print(banner)
