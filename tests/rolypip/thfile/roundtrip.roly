!import thfile {write, read, append, read_lines, size, exists, delete, list_dir, rename, copy}

print(exists("thfile_roundtrip.txt"))
write("thfile_roundtrip.txt", "line 1\n")
append("thfile_roundtrip.txt", "line 2")
print(read("thfile_roundtrip.txt"))
print(read_lines("thfile_roundtrip.txt"))
print(size("thfile_roundtrip.txt"))
rename("thfile_roundtrip.txt", "thfile_renamed.txt")
copy("thfile_renamed.txt", "thfile_copied.txt")
print(thfile.read_lines("thfile_copied.txt"))
print(thfile.list_dir("."))
thfile.delete("thfile_renamed.txt")
delete("thfile_copied.txt")
print(thfile.exists("thfile_renamed.txt"))
print(exists("thfile_copied.txt"))
