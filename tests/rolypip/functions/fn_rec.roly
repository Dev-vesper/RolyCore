fn factorial(n: int) {
    if (n <= 1) { return 1 }
    return n * factorial(n - 1)
}

fn fibonacci (n: int) {
    if (n < 2) { return n }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

fn sgn (n: int) {
    if (n < 0) { return -1 }
    if (n > 0) { return 1 }
    return 0
}

print(factorial(10))
print(fibonacci(15))
print(sgn(-42))
print(sgn(0))
print(sgn(42))
