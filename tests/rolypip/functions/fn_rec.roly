fn rec_fact(n: int) {
    if (n <= 1) { return 1 }
    return n * rec_fact(n - 1)
}

fn rec_fib (n: int) {
    if (n < 2) { return n }
    return rec_fib(n - 1) + rec_fib(n - 2)
}

fn sgn (n: int) {
    if (n < 0) { return -1 }
    if (n > 0) { return 1 }
    return 0
}

print(rec_fact(10))
print(rec_fib(15))
print(sgn(-42))
print(sgn(0))
print(sgn(42))
