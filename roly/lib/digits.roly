fn digit_count(n: int) {
    m = n
    if (m < 0) {
        m = -m
    }
    c = 1
    while (m > 9) {
        c += 1
        m = m / 10
    }
    return c
}

fn digit_sum(n: int) {
    m = n
    if (m < 0) {
        m = -m
    }
    s = 0
    while (m > 0) {
        s = s + m - m / 10 * 10
        m = m / 10
    }
    return s
}

fn digital_root(n: int) {
    m = n
    if (m < 0) {
        m = -m
    }
    while (m > 9) {
        m = digit_sum(m)
    }
    return m
}

fn reverse_digits(n: int) {
    m = n
    if (m < 0) {
        m = -m
    }
    r = 0
    while (m > 0) {
        r = r * 10 + m - m / 10 * 10
        m = m / 10
    }
    if (n < 0) {
        return -r
    }
    return r
}

fn is_palindrome(n: int) {
    if (n < 0) {
        return FALSE
    }
    return n == reverse_digits(n)
}
