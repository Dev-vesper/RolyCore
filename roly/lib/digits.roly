fn digit_count(n: int) {
    m = n
    if (m < 0) {
        m = -m
    }
    c = 1
    while (m > 9) {
        c += 1
        m = m / 10
    }
    return c
}

fn digit_sum(n: int) {
    m = n
    if (m < 0) {
        m = -m
    }
    s = 0
    while (m > 0) {
        s += mod(m, 10)
        m = m / 10
    }
    return s
}

fn reverse_digits(n: int) {
    m = n
    if (m < 0) {
        m = -m
    }
    r = 0
    while (m > 0) {
        r = r * 10 + mod(m, 10)
        m = m / 10
    }
    if (n < 0) {
        return -r
    }
    return r
}
