fn is_prime(n: int) {
    if (n < 2) {
        return FALSE
    }
    d = 2
    while (d * d <= n) {
        if (n / d * d == n) {
            return FALSE
        }
        d += 1
    }
    return TRUE
}

fn next_prime(n: int) {
    m = n + 1
    while (TRUE) {
        if (is_prime(m)) {
            return m
        }
        m += 1
    }
}

fn factorial(n: int) {
    if (n < 0) {
        return fail("factorial: n must be non-negative")
    }
    r = 1
    i = 2
    while (i <= n) {
        r *= i
        i += 1
    }
    return r
}

fn fibonacci(n: int) {
    if (n < 0) {
        return fail("fibonacci: n must be non-negative")
    }
    a = 0
    b = 1
    i = 0
    while (i < n) {
        t = a + b
        a = b
        b = t
        i += 1
    }
    return a
}

fn divisor_count(n: int) {
    if (n < 1) {
        return fail("divisor_count: n must be a positive integer")
    }
    c = 0
    d = 1
    while (d * d <= n) {
        if (n / d * d == n) {
            if (d * d == n) {
                c += 1
            } else {
                c += 2
            }
        }
        d += 1
    }
    return c
}

fn collatz_steps(n: int) {
    if (n < 1) {
        return fail("collatz_steps: n must be a positive integer")
    }
    m = n
    c = 0
    while (m != 1) {
        if (m / 2 * 2 == m) {
            m = m / 2
        } else {
            m = 3 * m + 1
        }
        c += 1
    }
    return c
}
