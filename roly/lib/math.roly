fn abs(n: int) {
    if (n < 0) {
        return -n
    }
    return n
}

fn sign(n: int) {
    if (n < 0) {
        return -1
    }
    if (n > 0) {
        return 1
    }
    return 0
}

fn min(a: int, b: int) {
    if (a < b) {
        return a
    }
    return b
}

fn max(a: int, b: int) {
    if (a > b) {
        return a
    }
    return b
}

fn clamp(n: int, lo: int, hi: int) {
    if (n < lo) {
        return lo
    }
    if (n > hi) {
        return hi
    }
    return n
}

fn mod(n: int, d: int) {
    return n - n / d * d
}

fn pow(b: int, e: int) {
    if (e < 0) {
        return fail("pow: exponent must be non-negative")
    }
    r = 1
    i = 0
    while (i < e) {
        r *= b
        i += 1
    }
    return r
}

fn gcd(a: int, b: int) {
    if (a < 0) {
        a = -a
    }
    if (b < 0) {
        b = -b
    }
    while (b != 0) {
        t = a - a / b * b
        a = b
        b = t
    }
    return a
}

fn lcm(a: int, b: int) {
    g = gcd(a, b)
    if (g == 0) {
        return 0
    }
    r = a / g * b
    if (r < 0) {
        return -r
    }
    return r
}

fn isqrt(n: int) {
    if (n < 0) {
        return fail("isqrt: n must be non-negative")
    }
    if (n < 2) {
        return n
    }
    x = n
    y = (x + n / x) / 2
    while (y < x) {
        x = y
        y = (x + n / x) / 2
    }
    return x
}
