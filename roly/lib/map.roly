// map.roly — a hash map over plain immutable lists.
//
// Representation: a map is a list of entries sorted by stored hash:
//     [[hash, key, value], ...]
// - hash: djb2 over str(key), kept in [0, 1000003) — str keys hash as
//   themselves, int/bool/float/list keys hash through their str() rendering,
//   so every value type can be a key (a key's identity follows its str()
//   rendering: 1 and 1.0 are different keys)
// - key/value: exactly what the caller passed in, stored as-is — parameters
//   are untyped, so no boxing is needed
//
// Lookup is a lower-bound binary search on the stored hashes followed by
// linear probing over the entries sharing that hash. Insertion reuses the
// lower bound as the insertion point, so the array stays sorted by hash
// without any re-sorting. map_merge walks both hash-sorted inputs in one
// ordered pass — no rehashing; on a key present in both sides, the right
// side wins, matched against the whole equal-hash run in b.
//
// Every public function validates the map's shape first: each entry must be
// a 3-item list. push() only accepts lists, so the length check doubles as
// a type check.

!import math {mod}

// djb2 (Bernstein) over the key's str() rendering: hash = hash * 33 + ord
fn _hash (k) {
    s = str(k)
    h = 5381
    i = 0
    while (i < len(s)) {
        h = mod(h * 33 + ord(char(s, i)), 1000003)
        i += 1
    }
    return h
}

// first index whose stored hash is >= h — lower-bound binary search
fn _lower_bound (m, h) {
    lo = 0
    hi = len(m)
    while (lo < hi) {
        mid = (lo + hi) / 2
        if (get(get(m, mid), 0) < h) {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo
}

// walk the collision chain; -1 when the key is absent
fn _find (m, h, k) {
    j = _lower_bound(m, h)
    while (j < len(m)) {
        e = get(m, j)
        if (get(e, 0) != h) {
            break
        }
        if (get(e, 1) == k) {
            return j
        }
        j += 1
    }
    return -1
}

// upsert: replace the entry in place when the key exists, otherwise insert
// at the lower bound so the array stays sorted by hash
fn _put_h (m, h, k, v) {
    i = _lower_bound(m, h)
    j = i
    while (j < len(m)) {
        e = get(m, j)
        if (get(e, 0) != h) {
            break
        }
        if (get(e, 1) == k) {
            return set(m, j, [h, k, v])
        }
        j += 1
    }
    return insert(m, i, [h, k, v])
}

// shape validation: every entry is a [hash, key, value] triple; the push()
// call rejects non-list entries
fn _validate (m) {
    i = 0
    while (i < len(m)) {
        if (len(push(get(m, i), 0)) != 4) {
            return fail("map: invalid map entry")
        }
        i += 1
    }
    return m
}

fn new_map () {
    return list()
}

fn map_set (m, k, v) {
    _validate(m)
    return _put_h(m, _hash(k), k, v)
}

fn map_get (m, k) {
    _validate(m)
    i = _find(m, _hash(k), k)
    if (i == -1) {
        return fail("map: key " + str(k) + " not found")
    }
    return get(get(m, i), 2)
}

fn map_has (m, k) {
    _validate(m)
    if (_find(m, _hash(k), k) == -1) {
        return FALSE
    }
    return TRUE
}

fn map_del (m, k) {
    _validate(m)
    i = _find(m, _hash(k), k)
    if (i == -1) {
        return fail("map: key " + str(k) + " not found")
    }
    return delete_at(m, i)
}

fn map_size (m) {
    _validate(m)
    return len(m)
}

// keys, values and items follow the stored hash order, not key order
fn map_keys (m) {
    _validate(m)
    r = list()
    i = 0
    while (i < len(m)) {
        r = push(r, get(get(m, i), 1))
        i += 1
    }
    return r
}

fn map_values (m) {
    _validate(m)
    r = list()
    i = 0
    while (i < len(m)) {
        r = push(r, get(get(m, i), 2))
        i += 1
    }
    return r
}

// [[key, value], ...] — feeds straight into map_equal
fn map_items (m) {
    _validate(m)
    r = list()
    i = 0
    while (i < len(m)) {
        r = push(r, [get(get(m, i), 1), get(get(m, i), 2)])
        i += 1
    }
    return r
}

// dict-style rendering: {name: Ali, age: 31, active: True} — keys and
// values both through str(), in stored hash order; empty map renders as {}
fn show (m) {
    _validate(m)
    r = "{"
    i = 0
    while (i < len(m)) {
        e = get(m, i)
        if (i > 0) {
            r = r + ", "
        }
        r = r + str(get(e, 1)) + ": " + str(get(e, 2))
        i += 1
    }
    return r + "}"
}

// ordered merge over the two hash-sorted inputs; the right side wins on
// shared keys. A key match scans the whole equal-hash chain in b, not just
// its first entry — colliding keys (7 vs "7") can sit anywhere in the run.
fn map_merge (a, b) {
    _validate(a)
    _validate(b)
    r = list()
    i = 0
    j = 0
    while (i < len(a)) {
        ha = get(get(a, i), 0)
        while (j < len(b)) {
            if (get(get(b, j), 0) < ha) {
                r = push(r, get(b, j))
                j += 1
            } else {
                break
            }
        }
        dup = FALSE
        k = j
        while (k < len(b)) {
            if (get(get(b, k), 0) != ha) {
                break
            }
            if (get(get(b, k), 1) == get(get(a, i), 1)) {
                dup = TRUE
                break
            }
            k += 1
        }
        if (dup == FALSE) {
            r = push(r, get(a, i))
        }
        i += 1
    }
    while (j < len(b)) {
        r = push(r, get(b, j))
        j += 1
    }
    return r
}
