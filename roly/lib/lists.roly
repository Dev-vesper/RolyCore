fn sum_list(l: list) {
    s = 0
    i = 0
    while (i < len(l)) {
        s += get(l, i)
        i += 1
    }
    return s
}

fn max_list(l: list) {
    if (len(l) == 0) {
        return fail("max_list: list must not be empty")
    }
    m = get(l, 0) + 0
    i = 1
    while (i < len(l)) {
        if (get(l, i) > m) {
            m = get(l, i)
        }
        i += 1
    }
    return m
}

fn min_list(l: list) {
    if (len(l) == 0) {
        return fail("min_list: list must not be empty")
    }
    m = get(l, 0) + 0
    i = 1
    while (i < len(l)) {
        if (get(l, i) < m) {
            m = get(l, i)
        }
        i += 1
    }
    return m
}

fn sublist(l: list, start: int, end: int) {
    a = start
    b = end
    if (a < 0) {
        a = 0
    }
    if (b > len(l)) {
        b = len(l)
    }
    r = list()
    i = a
    while (i < b) {
        r = push(r, get(l, i))
        i += 1
    }
    return r
}

fn remove_at(l: list, i: int) {
    if (i < 0) {
        return fail("remove_at: index out of range")
    }
    if (i >= len(l)) {
        return fail("remove_at: index out of range")
    }
    r = list()
    j = 0
    while (j < len(l)) {
        if (j != i) {
            r = push(r, get(l, j))
        }
        j += 1
    }
    return r
}

