fn is_even(n: int) {
    return n / 2 * 2 == n
}

fn is_odd(n: int) {
    return n / 2 * 2 != n
}

fn popcount(n: int) {
    m = n
    if (m < 0) {
        m = -m
    }
    c = 0
    while (m > 0) {
        c = c + m - m / 2 * 2
        m = m / 2
    }
    return c
}

fn bitlen(n: int) {
    m = n
    if (m < 0) {
        m = -m
    }
    c = 0
    while (m > 0) {
        c += 1
        m = m / 2
    }
    return c
}
