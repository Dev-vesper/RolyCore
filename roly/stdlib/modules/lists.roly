fn sum_list(l) {
    s = 0
    i = 0
    while (i < len(l)) {
        s += get(l, i)
        i += 1
    }
    return s
}

fn max_list(l) {
    if (len(l) == 0) {
        return fail("max_list: list must not be empty")
    }
    m = get(l, 0) + 0
    i = 1
    while (i < len(l)) {
        if (get(l, i) > m) {
            m = get(l, i)
        }
        i += 1
    }
    return m
}

fn min_list(l) {
    if (len(l) == 0) {
        return fail("min_list: list must not be empty")
    }
    m = get(l, 0) + 0
    i = 1
    while (i < len(l)) {
        if (get(l, i) < m) {
            m = get(l, i)
        }
        i += 1
    }
    return m
}

fn sublist(l, start, end) {
    a = start
    b = end
    if (a < 0) {
        a = 0
    }
    if (b > len(l)) {
        b = len(l)
    }
    r = list()
    i = a
    while (i < b) {
        r = push(r, get(l, i))
        i += 1
    }
    return r
}

