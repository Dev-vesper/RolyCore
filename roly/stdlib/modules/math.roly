fn abs(n) {
    if (n < 0) {
        return -n
    }
    return n
}

fn min(a, b) {
    if (a < b) {
        return a
    }
    return b
}

fn max(a, b) {
    if (a > b) {
        return a
    }
    return b
}

fn clamp(n, lo, hi) {
    if (lo > hi) {
        return fail("clamp: lo must not exceed hi")
    }
    if (n < lo) {
        return lo
    }
    if (n > hi) {
        return hi
    }
    return n
}

fn mod(n, d) {
    return n - n / d * d
}

fn gcd(a, b) {
    if (a < 0) {
        a = -a
    }
    if (b < 0) {
        b = -b
    }
    while (b != 0) {
        t = mod(a, b)
        a = b
        b = t
    }
    return a
}

fn lcm(a, b) {
    g = gcd(a, b)
    if (g == 0) {
        return 0
    }
    r = a / g * b
    if (r < 0) {
        return -r
    }
    return r
}

fn isqrt(n) {
    if (n < 0) {
        return fail("isqrt: n must be non-negative")
    }
    if (n < 2) {
        return n
    }
    x = n
    y = (x + n / x) / 2
    while (y < x) {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

fn is_prime(n) {
    if (n < 2) {
        return FALSE
    }
    d = 2
    while (d * d <= n) {
        if (mod(n, d) == 0) {
            return FALSE
        }
        d += 1
    }
    return TRUE
}
