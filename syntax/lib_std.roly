fn rep(s: str, n: int) {
    r = ""
    i = 0
    while (i < n) {
        r = r + s
        i += 1
    }
    return r
}

fn fact(n: int) {
    r = 1
    i = 2
    while (i <= n) {
        r *= i
        i += 1
    }
    return r
}

x = gcd(48, 18)
y = lcm(4, 6)
s = rep("=", 10)
big = fact(10)

print(x)
print(y)
print(binary(255))
print(hex(255))
print(to_base(2026, 2))
print(group(1234567))
print(pad(42, 5))
print(roman(2026))
print(s)
print(big)
print(digit_sum(big))
print(mod(-7, 3))
print(isqrt(994009))
